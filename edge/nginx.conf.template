# edge/nginx.conf.template — rendered via envsubst into /etc/nginx/conf.d/default.conf
# by the official nginx:1.27-alpine entrypoint. Only ${MYTUBE_*} placeholders are
# substituted (NGINX_ENVSUBST_FILTER=^MYTUBE_ in docker-compose.yml) so that native
# nginx variables ($uri, $slice_range, $secure_link_expires, $host,
# $upstream_cache_status) survive envsubst untouched (Pitfall A, 01-RESEARCH.md).
#
# secure_link_md5 below uses ${uri} in curly-braced form, not bare $uri. This is
# load-bearing, not style: nginx's variable-name parser greedily consumes the
# identifier characters that follow $uri, so once envsubst has substituted the real
# secret in place, a secret starting with an alnum character (every
# `openssl rand -hex` secret does) gets read as part of an unknown variable name
# ("$uri<secret-prefix>") and nginx refuses to start. Found while writing the
# integration test in src/tests/test_signing.py — the Python side of the formula
# (orchestrator/signing.py) is unaffected, since it does plain string
# concatenation and never touches nginx's own variable parser.

log_format cache_audit '$time_iso8601 $uri $slice_range $upstream_cache_status $status $body_bytes_sent $client_range_start';

proxy_cache_path /dev/shm/vid levels=1:2 keys_zone=vid:16m max_size=${MYTUBE_CACHE_SIZE} inactive=${MYTUBE_CACHE_INACTIVE} use_temp_path=off;

# Address comes from a variable, not a constant (verdict M7, D-16): edge must talk
# to the same storage the orchestrator writes to, including an external endpoint.
#
# The upstream is NAMED after the storage host rather than something descriptive
# like "storage-internal", and that is load-bearing for the external case. nginx
# derives both the default `Host` header and the TLS SNI name from the host part
# of proxy_pass, which for an upstream block is the block's own name -- so a
# descriptive name puts "storage-internal" into the SNI handshake and the Host
# header, which a public S3 endpoint has no reason to accept. Naming the block
# after the real host makes both correct with no extra directives.
#
# The block also has to stay a block rather than becoming a literal URL in
# proxy_pass: proxy_pass here contains $edition_id, and with a variable present
# nginx resolves the host at request time and demands a `resolver`. Upstream
# names are looked up before DNS, so this form needs none.
upstream ${MYTUBE_S3_HOST} {
    server ${MYTUBE_S3_UPSTREAM};
    keepalive 32;
}

upstream orchestrator {
    server api:8000;
    keepalive 8;
}

# External scheme for the 302 Location (ADDR-07, D-11). $scheme is the scheme as
# the edge sees it, which is http whenever TLS is terminated by an upstream proxy.
# Using it directly hands the client an http redirect from an https page: mixed
# content in a browser, and the wrong scheme for the player. So an incoming
# X-Forwarded-Proto wins, and $scheme stays as the fallback for reaching the edge
# directly with no proxy in front.
map $http_x_forwarded_proto $external_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

# Nested `if` is forbidden by nginx ("if" directive is not allowed here) — all
# branching lives in this map (verdict B4). Order matters: regexes are tried in
# the order they appear, and "serve" must win over "stub" so that a valid
# signature accompanied by a stale retry=1 marker still serves bytes.
#
# $secure_link == ""  -> signature invalid (forged/corrupt param)
# $secure_link == "0" -> signature valid, but $secure_link_expires has passed (D-03)
# $secure_link == "1" -> valid and current -> serve
map "$secure_link:$arg_retry" $blob_action {
    "~^1:"    serve;    # valid signature -> bytes, regardless of retry marker
    "~:1$"    stub;     # already retried once -> stub clip, not another redirect (D-04 loop-guard)
    default   refresh;  # first attempt with a bad/expired signature -> re-sign
}

# The master request logs an empty $slice_range, so on its own a log line
# cannot say which slice it fetched -- nginx's slice module serves the first
# slice a client asks for directly inside the master request, not as an
# internal-redirect subrequest. $client_range_start records where the
# client's own request began, which is what makes a linear start (byte 0)
# and a mid-file seek distinguishable after the fact: cache-report floors
# this offset to a slice boundary and merges the master line into the same
# bucket as any subrequest for that slice. Subrequest lines carry this field
# too and cache-report ignores it there -- expected, not a bug.
#
# Mapped, never $http_range logged raw: the header is client-controlled and
# a legitimate multi-range value contains a space, which in a
# space-delimited log line would shift every following field and let a
# client forge log content. This map emits digits or a single hyphen
# ("offset unknown") and nothing else; the field's last position in
# cache_audit is a second layer on the same concern.
map $http_range $client_range_start {
    default                        -;
    ""                             0;
    "~^bytes=(?<range_start>\d+)-" $range_start;
}

server {
    listen 80;
    server_name _;

    # `return 302 /refresh/$edition_id` below is relative, but nginx expands a
    # relative Location into an absolute URL using the scheme IT sees — http
    # whenever TLS is terminated upstream. That handed an https client an http
    # redirect and broke the D-04 loop guard behind a TLS-terminating proxy.
    # Off means the Location stays relative and the client resolves it against
    # whatever scheme, host and port it actually used. Scheme-agnostic, so it
    # needs no forwarded headers to be correct.
    absolute_redirect off;

    # D-21 originally listed only /v/, /p/, /blob/. This adds /refresh/ as a direct
    # consequence of D-04: nginx only knows edition_id (no slug), so re-signing goes
    # through edition_id and the player reopens this address itself — it must be
    # publicly reachable, not internal. Recorded here so the divergence from D-21 is
    # a visible decision, not silent drift.
    location /v/ {
        proxy_intercept_errors on;
        proxy_set_header X-Forwarded-Host  $http_host;
        proxy_set_header X-Forwarded-Proto $external_proto;
        proxy_pass http://orchestrator;
    }

    # The public playlist address (D-101..D-104), shaped identically to /v/
    # above: it only ever redirects, so it carries no signing, no slicing
    # and no caching of its own. Public rather than internal because a
    # video player reopens this address itself, the same reason /v/ and
    # /refresh/ are public.
    location /p/ {
        proxy_intercept_errors on;
        proxy_set_header X-Forwarded-Host  $http_host;
        proxy_set_header X-Forwarded-Proto $external_proto;
        proxy_pass http://orchestrator;
    }

    # Public, NOT internal: the player reopens this address itself (D-04).
    # Prefix match, NOT exact: always /refresh/{uuid}.
    # retry=1 on the /blob/ address is added by the orchestrator's own 302, not edge.
    location /refresh/ {
        proxy_set_header X-Forwarded-Host  $http_host;
        proxy_set_header X-Forwarded-Proto $external_proto;
        proxy_pass http://orchestrator;
    }

    # Strict UUID match: arbitrary strings never reach the object-storage key (ASVS V5).
    # The regex is quoted: nginx's config lexer treats an unquoted `{` as a block
    # delimiter even mid-token (no preceding whitespace needed), so an unquoted
    # `[0-9a-f]{8}` gets silently truncated before `{8}` and pcre2_compile fails on
    # the cut-off pattern ("missing closing parenthesis") — found while running the
    # verify step's `nginx -t` against this exact regex.
    location ~ "^/blob/(?<edition_id>[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\.mp4$" {
        proxy_intercept_errors on;

        secure_link     $arg_sig,$arg_exp;
        secure_link_md5 "$secure_link_expires${uri}${MYTUBE_SECURE_LINK_SECRET}";

        # Two SIBLING ifs, one return each — the officially safe subcase. Nested if
        # is forbidden; all branching already lives in the map above.
        if ($blob_action = refresh) { return 302 /refresh/$edition_id; }
        if ($blob_action = stub)    { return 403; }  # error_page below -> stub clip (D-31)

        # Mandatory (verdict B2): nginx does not log subrequests by default, and
        # slice works entirely through subrequests. Without this line
        # blob_access.log gets one line per client request instead of dozens, and
        # cache-report (plan 05) would measure nothing while reporting green.
        log_subrequest on;

        slice ${MYTUBE_SLICE_SIZE};
        proxy_set_header Range $slice_range;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        include /etc/nginx/conf.d/snippets/cache.conf;

        access_log /var/log/nginx/blob_access.log cache_audit;

        # Scheme is a variable because the storage can be either the one this
        # compose brings up (plain http inside an internal network) or an
        # external S3 over TLS (D-16). These three directives are inert when the
        # scheme is http, so one config covers both without branching.
        # Verification is ON deliberately: an unverified TLS connection is
        # encrypted but not authenticated, which buys nothing over http against
        # an attacker able to answer for the host.
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_verify_depth 3;

        proxy_pass ${MYTUBE_S3_SCHEME}://${MYTUBE_S3_HOST}/${MYTUBE_S3_BUCKET}/$edition_id.mp4;
    }

    # Stub clips instead of raw error codes (D-31, Pitfall G): AVPro shows every
    # error code as the same black screen, so every failure mode gets an explicit
    # =200 override — without it the client won't even try to play the body. The
    # fourth entry distinguishes one more failure a video player otherwise cannot
    # tell apart from a broken server: a playlist the operator has not finished
    # building yet (D-104). 425 is the application's own
    # PLAYLIST_NOT_READY_STATUS constant (orchestrator/web/routes_playlists.py) —
    # tests/test_edge_config.py ties the two together so they cannot drift apart.
    error_page 404             =200 /errors/not-found.mp4;
    error_page 410             =200 /errors/deleted.mp4;
    error_page 403 500 502 503 504 =200 /errors/unavailable.mp4;
    error_page 425             =200 /errors/playlist-not-ready.mp4;
    error_page 423             =200 /errors/preparing.mp4;

    location /errors/ {
        internal;
        alias /etc/nginx/errors/;
        # No add_header for the content type here: nginx already types these .mp4
        # files from mime.types, and add_header appends rather than replaces, so
        # the stub went out with Content-Type: video/mp4 listed twice. A duplicated
        # Content-Type is not something every player forgives.
    }
}
# ==== admin surface begins here ====
#
# The operator interface gets its own server block, appended here rather than
# interleaved with the delivery block above.
#
# - It stays second in file order on purpose: nginx treats the first `server`
#   block in a file as the implicit default for any Host that matches no
#   server_name exactly. Neither block carries a `default_server` marker, and
#   neither should — leaving the delivery block first keeps its own 404 ->
#   stub-clip handling as the answer for every Host that isn't the admin one.
# - server_name below is the operator's own hostname, an exact match rather
#   than a wildcard or `_`. The whole point of a second hostname is that only
#   that one name reaches this block.
# - This block carries none of the delivery block's machinery: no
#   secure_link, no slice, no cache include, no error_page stub-clip mapping,
#   no absolute_redirect off. A host that never serves video has no use for
#   any of it — this surface answers with real HTML and real redirects, not a
#   stub clip a video player can swallow.

# Rate-limit zone for the two public routes that reach a password hash
# (login and the one-time setup link). Declared here, above the server block
# that references it — despite both directives being valid anywhere at the
# http level (this whole file is already included inside it), nginx resolves
# a zone name where limit_req is parsed and rejects one it hasn't seen yet.
#
# Not a lockout and not an answer to password guessing — that is settled
# elsewhere as a constant delay and a real-cost hash, deliberately without a
# lockout, because a lockout lets any passer-by lock the operator out of
# their own interface by hammering the form with their username. This zone
# answers a different threat: each verification holds a worker thread and
# its configured memory for the better part of a second, so an unbounded
# burst is a resource attack on a process that also answers /v/{slug} for
# viewers. Ten a minute with a burst of five is far above anything a person
# types and far below anything that costs the process something.
limit_req_zone $binary_remote_addr zone=mytube_auth:1m rate=10r/m;

# A log format that never records the query string. The one-time setup link
# carries its token there, and the default combined format logs $request,
# which contains it, into a volume the api container also mounts. $uri
# stands in for $request below. Closing this copy of the token doesn't close
# every copy: the operator's own reverse proxy keeps its own log and the
# browser keeps its own history, both outside this repository.
log_format admin_audit '$time_iso8601 $uri $status $body_bytes_sent';

server {
    listen 80;
    server_name ${MYTUBE_ADMIN_FQDN};

    access_log /var/log/nginx/admin_access.log admin_audit;

    # Who the rate-limit zone above is actually counting. SETUP.md requires
    # an external reverse proxy in front of this stack, and every request
    # that arrives through it carries that proxy's address as its peer —
    # so without this, `$binary_remote_addr` is one value for the entire
    # internet and all of it shares a single bucket of ten a minute. A
    # stranger hammering the form would drain it and the operator's own
    # login and one-time setup link would answer 503: exactly the lockout
    # the application refused to implement, reintroduced one layer down.
    #
    # Scoped to this server block, not the http level, so the delivery
    # block's own view of its clients is untouched.
    #
    # Only the address named here is believed, so a forwarded header from
    # anywhere else is ignored rather than trusted.
    #
    # The address to name is the one this container sees, which is not the
    # reverse proxy's: Docker rewrites the source of anything arriving
    # through a published port, so what shows up here is the bridge
    # gateway whoever connected. The default covers the range those
    # gateways fall in. Naming the proxy's own address instead looks right
    # and silently turns the whole mechanism off — real_ip stops firing,
    # every caller collapses back to one key, and the only visible
    # difference is the address in a "limiting requests" log line.
    set_real_ip_from ${MYTUBE_TRUSTED_PROXY};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # An anonymous endpoint that runs a database query has no reason to be
    # reachable from the public internet. Docker's own healthcheck reaches
    # this path on localhost inside the container, which is its only
    # legitimate caller — refusing it here costs the healthcheck nothing.
    location = /healthz {
        return 404;
    }

    # A refused request gets nginx's own 503 — no error_page mapping here:
    # this block serves a person with a browser, not a video player that
    # cannot render a status page.
    location = /login {
        limit_req zone=mytube_auth burst=5 nodelay;
        proxy_set_header X-Forwarded-Host  $http_host;
        proxy_set_header X-Forwarded-Proto $external_proto;
        proxy_pass http://orchestrator;
    }

    location = /setup {
        limit_req zone=mytube_auth burst=5 nodelay;
        proxy_set_header X-Forwarded-Host  $http_host;
        proxy_set_header X-Forwarded-Proto $external_proto;
        proxy_pass http://orchestrator;
    }

    # The forwarded host header is load-bearing, not decorative: nginx does
    # not pass the client's real Host through proxy_pass by default, and the
    # application's own hostname check reads this header instead.
    location / {
        proxy_set_header X-Forwarded-Host  $http_host;
        proxy_set_header X-Forwarded-Proto $external_proto;
        proxy_pass http://orchestrator;
    }
}

# Copy to .env and fill in real values. .env is gitignored; this file is not.

# --- Postgres (consumed by the postgres:16-alpine image directly; keep the
# password in sync with the one embedded in MYTUBE_DATABASE_URL below) ---
POSTGRES_USER=mytube
POSTGRES_PASSWORD=change-me-generate-a-real-password
POSTGRES_DB=mytube

# --- orchestrator/config.py Settings (MYTUBE_ prefix) ---

# Secret behind secure_link_md5 (D-01/D-02). Generate, never commit:
#   openssl rand -hex 32
MYTUBE_SECURE_LINK_SECRET=change-me-generate-a-real-secret

# Signature lifetime in seconds; 12h per D-03.
MYTUBE_SIGN_TTL_SECONDS=43200

# Must match POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB above.
MYTUBE_DATABASE_URL=postgresql://mytube:change-me-generate-a-real-password@db:5432/mytube

# D-16: if set to an external host, api and edge both use it - see
# MYTUBE_S3_UPSTREAM below, which must point at the same storage.
MYTUBE_S3_ENDPOINT=http://storage:8333
MYTUBE_S3_BUCKET=mytube
MYTUBE_S3_REGION=mytube

# Generate, never commit:
#   openssl rand -hex 16   (key)
#   openssl rand -hex 32   (secret)
# Must match the identity "mytube" that src/storage/entrypoint.sh writes
# into s3.json from these same two values.
MYTUBE_S3_KEY=change-me-generate-a-real-key
MYTUBE_S3_SECRET=change-me-generate-a-real-secret

# D-13: soft-delete grace window before physical deletion, seconds.
MYTUBE_DELETE_GRACE_SECONDS=300

# host:port form of the same storage MYTUBE_S3_ENDPOINT points at - used by
# edge's storage-internal upstream (a proxied storage endpoint). The first release only supports the
# internal address over plain HTTP; D-38 requires storage be unreachable
# from outside, so an "external endpoint" per D-16 means another machine on
# the owner's internal network, never a public S3 endpoint.
MYTUBE_S3_UPSTREAM=storage:8333

# --- edge cache (DELIV-08) ---

# memory | off - selects src/edge/cache-${MYTUBE_CACHE_MODE}.conf.template
MYTUBE_CACHE_MODE=memory
MYTUBE_CACHE_SIZE=512m
MYTUBE_CACHE_INACTIVE=120s
MYTUBE_SLICE_SIZE=1m
MYTUBE_CACHE_LOCK_TIMEOUT=20s

# --- edge ---
MYTUBE_EDGE_PORT=8080

# --- backup (D-15) ---

# Where dumps land, bind-mounted to ./data/backups on the host (already
# covered by the top-level /data/ rule in .gitignore).
MYTUBE_BACKUP_DIR=/backups
# Dumps older than this many days are deleted on every run.
MYTUBE_BACKUP_KEEP_DAYS=7

# --- cache-warm (verdict M5) ---

# Warm limit in bytes: default is half of MYTUBE_CACHE_SIZE's 512m default
# (268435456 bytes) -- warming one title should not evict everything else
# in the cache zone. Only the start of a file gets warmed; see
# `orchestrator/cli/cache_warm.py` for the full arithmetic.
MYTUBE_WARM_BYTES=268435456

# --- Web interface ---

# The bare hostname the operator interface answers on -- no scheme, no
# trailing slash. Must not be the same name as the delivery address: the
# whole separation between a viewer's answer and an operator's answer
# rests on the two names being different. Left empty here so a fresh
# clone cannot start with somebody else's hostname baked in.
MYTUBE_ADMIN_FQDN=

# Origin viewers reach for the copy-link button, scheme included, no
# trailing slash, e.g. https://mytube.example.com. The service refuses to
# start without it -- a bare hostname produces a copied link that silently
# does not work in a player.
MYTUBE_PUBLIC_BASE_URL=https://mytube.example.com

# --- Source share (SMB/CIFS) ---
#
# Where the video files to import are read from. The stack mounts the share
# itself and gives api a read-only view of it at /share, so a new host needs
# no preparation beyond a filled-in .env.
#
# The address, in the form a CIFS mount takes -- forward slashes, no trailing
# one. A Windows UNC path such as \\host\share is the same address written the
# other way round: //host/share. Left empty here, like the admin hostname
# above, so a fresh clone cannot start with somebody else's server baked in.
MYTUBE_SHARE_URL=

# Credentials for that share. Read-only access on the server's side is enough
# -- nothing in this project writes back to the source. Both stay empty here
# and get their real values in .env, which is gitignored; this file is not.
MYTUBE_SHARE_USERNAME=
MYTUBE_SHARE_PASSWORD=

# Only for a domain-joined share. Leave empty for a local account on the
# machine serving it.
MYTUBE_SHARE_DOMAIN=

# D-67: 0 means no quota enforced; used only for the usage figure shown in
# the interface for now.
MYTUBE_STORAGE_QUOTA_BYTES=0

# --- Conversion worker ---
#
# The converter's only credential -- opens the /worker/ prefix, checked in
# constant time against every request under it. Required, no default: an
# empty value would compare equal to a missing header and open the whole
# prefix. Both this service and the converter must be given the same value.
# Generate, never commit:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MYTUBE_WORKER_TOKEN=change-me-generate-a-real-token

# D-131: seconds with no converter check-in before a queued conversion shows
# "waiting for a converter" instead of plain "queued". Keep this
# comfortably longer than the converter's own polling interval.
MYTUBE_CONVERTER_OFFLINE_SECONDS=60

# D-136: advisory bitrate above which a compatible source earns a
# recommendation to convert instead. Gates nothing -- as-is stays allowed.
MYTUBE_TRANSCODE_BITRATE_CEILING_BPS=9000000

# D-137: output bitrate ceiling for a full-height (1080p) transcode; scaled
# down by area for a smaller output frame.
MYTUBE_TRANSCODE_TARGET_BITRATE_BPS=6000000

# D-148: fallback realtime-speed estimate used before any transcode has
# finished. Measured history replaces this once a job completes.
MYTUBE_TRANSCODE_ESTIMATE_REALTIME_FACTOR=4.0

# --- The converter itself (worker/settings.py, run separately via
# docker-compose.worker.yml on the machine with the card) ---
#
# Where the converter reaches this service -- scheme included, no trailing
# slash. Required, no default: this variable is not read by this service
# at all, only by the converter's own process on the GPU machine.
MYTUBE_ORCHESTRATOR_URL=https://admin.mytube.example

# The converter's own storage credential -- put and abort-multipart on the
# bucket above, nothing else. Deliberately NOT the same variable names as
# MYTUBE_S3_KEY/MYTUBE_S3_SECRET above: a narrower account only stays
# narrower if nothing lets the process silently pick up the wider one
# (D-115). Scope this to its own MinIO user rather than reusing the
# service's key, even on a single machine running both.
# Generate, never commit:
#   openssl rand -hex 16   (key)
#   openssl rand -hex 32   (secret)
MYTUBE_WORKER_S3_KEY=change-me-generate-a-narrower-key
MYTUBE_WORKER_S3_SECRET=change-me-generate-a-narrower-secret

# The converter signs its uploads with MYTUBE_S3_REGION above, exactly as
# this service does, and the two have to carry the same value: a region
# that does not match the one the storage was set up with is rejected as
# SignatureDoesNotMatch, at the end of a conversion the card has already
# paid for. Running the converter from a separate environment file (a
# different machine is the normal case) means copying MYTUBE_S3_ENDPOINT,
# MYTUBE_S3_BUCKET and MYTUBE_S3_REGION into it -- the credential is the
# only one of the four that is the converter's own.

# The converter's own name, defaulting to the machine's own hostname when
# unset -- carried on every claim and heartbeat so a job remembers who
# took it (D-117).
MYTUBE_WORKER_NAME=

# The free-VRAM floor (MiB) below which the converter reports "waiting for
# GPU" instead of claiming (D-113). See worker/settings.py's own comment
# for how the default was chosen and when to override it.
MYTUBE_WORKER_VRAM_MIN_MIB=1536

# How often the converter polls when idle or waiting for the card, seconds.
MYTUBE_WORKER_POLL_SECONDS=5.0

# A lever, not a resolution setting: the encoder's output width ceiling,
# defaulting to mytube_media.transcode's own 1080p default. Dropping this
# is the one adjustment that changes a conversion's cost substantially if
# the five-minute measurement on the real card comes back long.
MYTUBE_WORKER_MAX_OUTPUT_WIDTH=1920

# docker-compose.worker.yml only -- where the GPU host's own mount of the
# source share is bind-mounted from, and where the converter's scratch
# space lives on that host's disk. Neither is read by any Python code;
# both default to a folder beside this compose file for a quick local try.
MYTUBE_SHARE_HOST_PATH=./share
MYTUBE_WORKER_SCRATCH_PATH=./worker-scratch
